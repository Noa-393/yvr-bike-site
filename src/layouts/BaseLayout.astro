---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GlobalStyles from "../components/GlobalStyles.astro";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	/** Webflow page id for `data-wf-page` (defaults to home from index.html). */
	pageId?: string;
}

const {
	title,
	description,
	ogImage,
	pageId = "69c21645af4328ddcab6d53a",
} = Astro.props;

const wfSite = "69c21644af4328ddcab6d4c0";
const wfMod =
	'!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);';
---

<!DOCTYPE html>
<html data-wf-domain="yvr.bike" data-wf-page={pageId} data-wf-site={wfSite}>
	<head>
		<meta charset="utf-8" />
		<style is:inline>
			.wf-force-outline-none[tabindex="-1"]:focus {
				outline: none;
			}
		</style>
		<link href="https://cdn.prod.website-files.com/" rel="preconnect" crossorigin="anonymous" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<meta content="Webflow" name="generator" />
		<link
			href="/css/yvr-bike-b6a89d.webflow.shared.488df7280.css"
			rel="stylesheet"
			type="text/css"
			integrity="sha384-SI33KAu9oQSOg0qDkY932kz4mxtwxx2NUs0QQIyXSvkAlqn226ZvMliHwcYB8Z5N"
			crossorigin="anonymous"
		/>
		<link href="/fonts/ibm-plex-sans-oswald.css" rel="stylesheet" type="text/css" />
		<link href="/fonts/open-sans.css" rel="stylesheet" type="text/css" />
		<script is:inline type="text/javascript" set:html={wfMod}></script>
		<link
			href="https://cdn.prod.website-files.com/69c21644af4328ddcab6d4c0/69ccaa6cf04a9242b043afa7_Copy%20of%20Velo%20Femme%20(40%20x%2040%20px)%20(5).png"
			rel="icon"
			type="image/png"
			sizes="32x32"
			media="(prefers-color-scheme: light)"
		/>
		<link
			href="https://cdn.prod.website-files.com/69c21644af4328ddcab6d4c0/69cca9edcd310db5ba74d9d4_Copy%20of%20Velo%20Femme%20(40%20x%2040%20px)%20(3).png"
			rel="icon"
			type="image/png"
			sizes="32x32"
			media="(prefers-color-scheme: dark)"
		/>
		<link
			href="https://cdn.prod.website-files.com/69c21644af4328ddcab6d4c0/69ccaaad3452cfebffd7fa50_Copy%20of%20Velo%20Femme%20(40%20x%2040%20px)%20(256%20x%20256%20px).png"
			rel="apple-touch-icon"
		/>
		<style is:inline>
			* {
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				-o-font-smoothing: antialiased;
			}
		</style>
		<slot name="head" />
	</head>
	<body>
		<div class="page-wrapper">
			<GlobalStyles />
			<Header />
			<slot />
			<Footer />
		</div>
		<script
			is:inline
			src="/js/jquery-3.5.1.min.dc5e7f18c8.js"
			type="text/javascript"
			integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
			crossorigin="anonymous"></script>
		<script
			is:inline
			src="/js/webflow.schunk.36b8fb49256177c8.js"
			type="text/javascript"
			integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G"
			crossorigin="anonymous"></script>
		<script
			is:inline
			src="/js/webflow.01581add.585263ee144001f2.js"
			type="text/javascript"
			integrity="sha384-+4ZwlMdqfP2kbZGz65kdcgdqFaUmKFyA0fJoV5A6Y0iyBP0ueKliO9KCrjcBRjAa"
			crossorigin="anonymous"></script>
	</body>
</html>
