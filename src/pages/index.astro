---
import BaseLayout from "../layouts/BaseLayout.astro";
import main from "../markup/main-home.html?raw";
import jsonLd from "../markup/home-jsonld.html?raw";

const title = "Vancouver Cycling Directories | Routes, Clubs, retails, events and more";
const description =
	"The complete cycling directory for Vancouver. Discover curated routes, local clubs, events, retailers, and communities. Everything cyclists need in one place.";
---

<BaseLayout title={title} description={description} pageId="69c21645af4328ddcab6d53a">
	<script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
	<Fragment set:html={main} />
</BaseLayout>
